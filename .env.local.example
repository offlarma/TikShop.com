# =====================================================================
# App
# =====================================================================
# Public URL of this deployment. Used to build Stripe checkout and auth
# callback redirect URLs. Set to your production domain when deploying.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================================
# Supabase (required)
# =====================================================================
# Project URL and anon key — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service-role key — Project Settings → API → service_role.
# ONLY used server-side by the Stripe webhook to write the subscriptions
# table. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =====================================================================
# OpenAI (required for /api/ugc-scripts, /api/outreach, /api/copy-optimizer)
# =====================================================================
OPENAI_API_KEY=your-openai-api-key

# =====================================================================
# Database migrations (optional, only needed for `npm run db:migrate`)
# =====================================================================
# Direct Postgres connection string — Supabase Dashboard → Project
# Settings → Database → Connection string → URI.
# Append `?sslmode=require`.
# Example:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# =====================================================================
# Stripe (optional — app runs in "free-only" mode without these)
# =====================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs created in Stripe Dashboard → Products. Both should be
# recurring/monthly prices.
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# =====================================================================
# Rate limiting (optional — falls back to in-memory token bucket)
# =====================================================================
# Upstash Redis REST endpoint, used for cross-instance rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

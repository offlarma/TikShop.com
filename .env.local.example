# =====================================================================
# Supabase (required)
# =====================================================================
# Project URL and anon key — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# =====================================================================
# OpenAI (required for /api/ugc-scripts, /api/outreach, /api/copy-optimizer)
# =====================================================================
OPENAI_API_KEY=your-openai-api-key

# =====================================================================
# Database migrations (optional, only needed for `npm run db:migrate`)
# =====================================================================
# Direct Postgres connection string — Supabase Dashboard → Project Settings
# → Database → Connection string → URI.
# Use the "Session pooler" (port 6543) or "Direct" (port 5432) connection
# and append `?sslmode=require`.
# Example:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
